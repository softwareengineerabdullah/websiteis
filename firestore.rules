rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. İletişim Formu (Herkes mesaj atabilir)
    match /contact_messages/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 2. Site İçeriği (Ayarlar, Referanslar, Blog)
    // Herkes OKUYABİLİR (Footer ve sayfalarda görünmesi için şart)
    // Sadece Admin YAZABİLİR
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /references/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Genel Kural (Diğer her şey için admin kilidi)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
